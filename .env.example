# Firebase project (Firestore is the shared server database). Create a project at
# https://console.firebase.google.com, enable Firestore, then Project Settings ->
# Service accounts -> Generate new private key. Copy the three values from that JSON file.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the private key exactly as in the JSON file (it contains literal \n sequences —
# keep them as \n, do not turn them into real newlines in this .env file).
FIREBASE_PRIVATE_KEY=""

# --- Email (transactional) ---
# Provider: Resend (https://resend.com). Create an API key at Resend -> API Keys, and verify
# a sender domain at Resend -> Domains before EMAIL_FROM will work with your own domain (you
# can also send from the shared onboarding@resend.dev address for quick testing).
# Leave EMAIL_API_KEY unset to disable real sending; notifications will still be recorded
# with status SKIPPED instead of failing the booking.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="Mehndi By Dhara <onboarding@resend.dev>"
# Optional: without a verified domain, EMAIL_FROM must stay the shared resend.dev address.
# Set this to your real inbox so "Reply" on any sent email goes there instead.
EMAIL_REPLY_TO=""

# --- Analytics ---
# PostHog (https://posthog.com). Project Settings -> Project API Key. This key is meant to
# be public (it's exposed to the browser via NEXT_PUBLIC_*) — it can only send events, not
# read data. Leave unset to disable analytics entirely (no script loads, no tracking).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
